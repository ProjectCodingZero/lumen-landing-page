{

  "plugins": ["typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/env.d.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    },
    {
      "files": ["src/Routes.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
