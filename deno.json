{
  "version": "0.0.0",
  "nodeModulesDir": "auto",
  "lint": {
    "include": ["src/"],
    "exclude": ["src/testdata/", "src/fixtures/**/*.ts"],
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": ["no-unused-vars"]
    }
  },
  "tasks": {
    "dev": "deno run -A npm:astro dev",
    "build": "deno run -A npm:astro build",
    "lint": "deno run -A npm:oxlint",
    "preview": "deno task build && deno run -A npm:wrangler dev",
    "start": "deno task build && deno task preview",
    "astro": "deno run -A npm:astro",
    "deploy": "deno task build && deno run -A npm:wrangler deploy"
  },
  "imports": {
    "@astrojs/cloudflare": "npm:@astrojs/cloudflare@^14.4.7",
    "@astrojs/sitemap": "npm:@astrojs/sitemap@^3.7.4",
    "@deno/astro-adapter": "npm:@deno/astro-adapter@^0.6.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.5",
    "@types/react": "npm:@types/react@^19.3.0",
    "@types/react-dom": "npm:@types/react-dom@^19.3.0",
    "astro": "npm:astro@^7.4.11",
    "oxlint": "npm:oxlint@^1.93.0",
    "react": "npm:react@^19.3.1",
    "react-dom": "npm:react-dom@^19.3.1",
    "react-router-dom": "npm:react-router-dom@^7.18.5",
    "tailwindcss": "npm:tailwindcss@^4.3.5",
    "vite-plugin-svgr": "npm:vite-plugin-svgr@^5.2.0",

    "@/": "./src/",
    "@features/": "./src/features/",
    "@shared/": "./src/shared/",
    "@layout/": "./src/layout/",
    "wrangler": "npm:wrangler@^4.161.0"
  },
  "fmt": {
    "useTabs": false,
    "indentWidth": 2
  },

  "allowScripts": {
    "allow": ["npm:esbuild@0.21.5", "npm:sharp@0.33.5"],
    "deny": []
  }
}
