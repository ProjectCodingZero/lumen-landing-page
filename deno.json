{
  "version": "0.0.0",
  "nodeModulesDir": "auto",
  "lint": {
    "include": ["src/"],
    "exclude": ["src/testdata/", "src/fixtures/**/*.ts"],
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": ["no-unused-vars"]
    }
  },
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:typescript/tsc -b && deno run -A npm:vite build",
    "lint": "deno run -A npm:oxlint",
    "preview": "deno run -A npm:vite preview",
    "start": "deno task build && deno task preview"
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@rolldown/pluginutils": "npm:@rolldown/pluginutils@^1.0.1",
    "@types/deno": "npm:@types/deno@^2.7.0",
    "@types/node": "npm:@types/node@^26.5.0",
    "@types/react": "npm:@types/react@^19.2.18",
    "@types/react-dom": "npm:@types/react-dom@^19.2.7",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.1.1",
    "axios": "npm:axios@^1.20.0",
    "deno": "npm:deno@^2.9.6",
    "oxlint": "npm:oxlint@^1.82.0",
    "react": "npm:react@^19.2.8",
    "react-dom": "npm:react-dom@^19.2.8",
    "react-router-dom": "npm:react-router-dom@^7.18.3",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "vite": "npm:vite@^8.2.2",
    "vite-plugin-svgr": "npm:vite-plugin-svgr@^5.2.0",

    "@/": "./src/",
    "@features/": "./src/features/",
    "@shared/": "./src/shared/",
    "@layout/": "./src/layout/"
  },
  "fmt": {
    "useTabs": false,
    "indentWidth": 2
  }
}
