---
import Icon from "../ui/Icon.astro";

const testimonials = [
  {
    quote:
      "Reservar el turno me llevó menos de un minuto y la historia de Milo siempre está a mano, incluso cuando viajamos.",
    name: "Marta C.",
    role: "Tutora de Milo · Lumen App",
    initials: "MC",
    tone: "bg-brand-100 text-brand-700",
  },
  {
    quote:
      "Ahora la agenda, la historia clínica y los tutores viven en el mismo lugar. Dejamos de perseguir planillas.",
    name: "Dra. Lucía Paz",
    role: "Directora médica · Lumen Web",
    initials: "LP",
    tone: "bg-teal-100 text-teal-700",
  },
  {
    quote:
      "Con Lumen Web el equipo sabe qué pasa con cada paciente sin preguntar. Y las familias sienten la diferencia.",
    name: "Pedro R.",
    role: "Coordinador de clínica · Lumen Web",
    initials: "PR",
    tone: "bg-ink-100 text-ink-700",
  },
];
---

<section
  aria-labelledby="testimonials-title"
  class="border-y border-ink-900/6 bg-white"
>
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-24">
    <div
      class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end"
    >
      <div class="max-w-2xl">
        <span
          class="text-[11px] font-bold tracking-[0.22em] text-teal-600 uppercase"
        >
          Historias de ambos lados
        </span>
        <h2
          id="testimonials-title"
          class="mt-3 font-display text-3xl leading-tight tracking-tight text-ink-900 sm:text-4xl md:text-5xl"
        >
          Lo que cambia cuando todo está conectado
        </h2>
      </div>

      <div
        class="flex items-center gap-3 rounded-2xl border border-ink-900/8 bg-cream px-4 py-3"
      >
        <div class="flex text-brand-500" aria-hidden="true">
          {
            Array.from({ length: 5 }).map(() => (
              <Icon name="star" class="h-4 w-4" />
            ))
          }
        </div>
        <p class="text-xs font-semibold text-ink-700">
          4.9 · opiniones de tutores y clínicas
        </p>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        testimonials.map((testimonial) => (
          <figure class="flex h-full flex-col justify-between rounded-3xl border border-ink-900/6 bg-cream/70 p-6 transition-colors hover:border-teal-200">
            <div>
              <div
                class="flex text-brand-500"
                aria-label="Calificación: 5 de 5 estrellas"
              >
                {Array.from({ length: 5 }).map(() => (
                  <Icon name="star" class="h-4 w-4" />
                ))}
              </div>
              <blockquote class="mt-4 text-sm leading-relaxed text-ink-600">
                “{testimonial.quote}”
              </blockquote>
            </div>
            <figcaption class="mt-6 flex items-center gap-3">
              <span
                class:list={[
                  "grid h-10 w-10 place-items-center rounded-full text-xs font-extrabold",
                  testimonial.tone,
                ]}
                aria-hidden="true"
              >
                {testimonial.initials}
              </span>
              <div>
                <p class="text-sm font-bold text-ink-900">{testimonial.name}</p>
                <p class="text-xs text-ink-400">{testimonial.role}</p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
