---
import Icon from "../ui/Icon.astro";
import { products } from "../../data/products.ts";
---

<section
  id="productos"
  aria-labelledby="ecosystem-title"
  class="mx-auto max-w-7xl px-6 pt-4 pb-16 md:pb-24"
>
  <div class="mx-auto max-w-2xl text-center">
    <span class="text-[11px] font-bold tracking-[0.22em] text-teal-600 uppercase">
      Elegí tu lado de Lumen
    </span>
    <h2
      id="ecosystem-title"
      class="mt-3 font-display text-3xl leading-tight tracking-tight text-ink-900 sm:text-4xl md:text-5xl"
    >
      Un ecosistema, dos formas de entrar
    </h2>
    <p class="mt-4 text-base leading-relaxed text-ink-500">
      Lumen App para tutores. Lumen Web para clínicas. La misma información,
      siempre sincronizada.
    </p>
  </div>

  <div class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-2">
    {
      products.map((product) => {
        const isApp = product.id === "app";
        return (
          <article
            class:list={[
              "group relative flex flex-col overflow-hidden rounded-[2rem] p-7 transition-all duration-300 sm:p-9",
              isApp
                ? "bg-ink-900 text-white shadow-[0_40px_100px_-45px_rgba(6,27,29,0.9)] hover:-translate-y-1"
                : "border border-ink-900/8 bg-white shadow-[0_1px_0_rgba(11,43,46,0.03)] hover:-translate-y-1 hover:border-teal-200 hover:shadow-[0_30px_70px_-38px_rgba(11,43,46,0.35)]",
            ]}
          >
            {/* Decoración */}
            <div
              aria-hidden="true"
              class:list={[
                "pointer-events-none absolute inset-0",
                isApp
                  ? "bg-[radial-gradient(#ffffff_1px,transparent_1px)] opacity-[0.06] [background-size:22px_22px]"
                  : "bg-[radial-gradient(#c5d9d5_1px,transparent_1px)] opacity-30 [background-size:24px_24px] [mask-image:linear-gradient(to_bottom,black,transparent_70%)]",
              ]}
            >
            </div>
            <div
              aria-hidden="true"
              class:list={[
                "pointer-events-none absolute -top-20 -right-16 h-56 w-56 rounded-full blur-3xl",
                isApp ? "bg-teal-500/20" : "bg-brand-100/70",
              ]}
            >
            </div>

            <div class="relative flex items-start justify-between gap-4">
              <span
                class:list={[
                  "grid h-14 w-14 place-items-center rounded-2xl shadow-lg",
                  isApp
                    ? "bg-white/10 text-teal-300 shadow-ink-950/30"
                    : "bg-gradient-to-br from-teal-50 to-teal-100 text-teal-700 shadow-teal-900/5",
                ]}
              >
                <Icon name={isApp ? "paw" : "stethoscope"} class="h-7 w-7" />
              </span>
              <span
                class:list={[
                  "rounded-full px-3 py-1 text-[10px] font-bold tracking-[0.16em] uppercase",
                  isApp
                    ? "border border-white/15 bg-white/5 text-teal-200"
                    : "bg-cream text-ink-500",
                ]}
              >
                {product.audience}
              </span>
            </div>

            <h3
              class:list={[
                "relative mt-6 font-display text-3xl leading-none tracking-tight",
                isApp ? "text-white" : "text-ink-900",
              ]}
            >
              {product.name}
            </h3>
            <p
              class:list={[
                "relative mt-3 max-w-md text-sm leading-relaxed",
                isApp ? "text-white/65" : "text-ink-500",
              ]}
            >
              {product.description}
            </p>

            <ul class="relative mt-6 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
              {product.features.map((feature) => (
                <li
                  class:list={[
                    "flex items-start gap-2 text-xs font-medium",
                    isApp ? "text-white/80" : "text-ink-600",
                  ]}
                >
                  <span
                    class:list={[
                      "mt-0.5 grid h-4 w-4 shrink-0 place-items-center rounded-full",
                      isApp
                        ? "bg-teal-400/20 text-teal-300"
                        : "bg-teal-50 text-teal-600",
                    ]}
                  >
                    <Icon name="check" class="h-2.5 w-2.5" />
                  </span>
                  {feature}
                </li>
              ))}
            </ul>

            <a
              href={product.href}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                "group/cta relative mt-8 inline-flex w-fit items-center gap-2 rounded-full px-5 py-3 text-sm font-bold transition-colors",
                isApp
                  ? "bg-white text-ink-900 hover:bg-teal-50"
                  : "bg-ink-900 text-white hover:bg-teal-700",
              ]}
            >
              {product.cta}
              <Icon
                name="arrow-up-right"
                class="h-4 w-4 transition-transform group-hover/cta:translate-x-0.5 group-hover/cta:-translate-y-0.5"
              />
            </a>
          </article>
        );
      })
    }
  </div>

  <p class="mt-6 text-center text-xs font-medium text-ink-400">
    ¿Tenés una mascota? Abrí Lumen App. ¿Tenés una clínica? Entrá a Lumen Web.
  </p>
</section>
