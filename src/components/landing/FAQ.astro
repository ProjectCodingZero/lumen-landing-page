---
import { faqs } from "../../data/faqs.ts";
---

<section
  aria-labelledby="faq-title"
  class="mx-auto max-w-4xl px-6 pb-16 md:pb-24"
>
  <div class="mx-auto max-w-2xl text-center">
    <span class="text-[11px] font-bold tracking-[0.22em] text-teal-600 uppercase">
      Preguntas frecuentes
    </span>
    <h2
      id="faq-title"
      class="mt-3 font-display text-3xl leading-tight tracking-tight text-ink-900 sm:text-4xl md:text-5xl"
    >
      Todo lo que necesitás saber
    </h2>
    <p class="mt-4 text-base leading-relaxed text-ink-500">
      Si tu consulta no está acá, escribinos y te respondemos a la brevedad.
    </p>
  </div>

  <div class="mt-10 space-y-3">
    {
      faqs.map((faq) => (
        <details class="group rounded-2xl border border-ink-900/8 bg-white px-5 py-4 shadow-[0_1px_0_rgba(11,43,46,0.03)] transition-colors open:border-teal-200">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-sm font-bold text-ink-900 [&::-webkit-details-marker]:hidden">
            {faq.question}
            <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-cream text-ink-500 transition-transform duration-300 group-open:rotate-45">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                class="h-3.5 w-3.5"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 pr-10 text-sm leading-relaxed text-ink-500">
            {faq.answer}
          </p>
        </details>
      ))
    }
  </div>
</section>
