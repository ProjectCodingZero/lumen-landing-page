---
import Icon from "../ui/Icon.astro";

const highlights = [
  "Agenda unificada para todo el equipo",
  "Historia clínica siempre a mano",
  "Recordatorios que reducen ausencias",
  "Reportes claros para decidir mejor",
];

const weeklyRevenue = [38, 52, 44, 66, 58, 78, 92];

const appointments = [
  { time: "09:30", pet: "Milo", service: "Control", tone: "bg-teal-400" },
  { time: "11:00", pet: "Nala", service: "Vacunación", tone: "bg-brand-400" },
  { time: "16:30", pet: "Luna", service: "Estética", tone: "bg-teal-400" },
];
---

<section
  id="plataforma"
  aria-labelledby="platform-title"
  class="relative px-4 pb-16 sm:px-6 md:pb-24"
>
  <div
    class="relative mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-ink-900 px-6 py-12 shadow-[0_40px_100px_-45px_rgba(6,27,29,0.9)] sm:rounded-[2.5rem] sm:px-10 lg:px-14 lg:py-16"
  >
    <!-- Textura -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(#ffffff_1px,transparent_1px)] opacity-[0.06] [background-size:22px_22px]"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-24 -right-20 h-80 w-80 rounded-full bg-teal-500/20 blur-3xl"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-24 -left-16 h-72 w-72 rounded-full bg-brand-500/15 blur-3xl"
    >
    </div>

    <div
      class="relative grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16"
    >
      <!-- Copy -->
      <div class="max-w-lg text-white">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-[10px] font-bold tracking-[0.2em] text-teal-200 uppercase"
        >
          <Icon name="paw" class="h-3.5 w-3.5" />
          Lumen para clínicas
        </span>
        <h2
          id="platform-title"
          class="mt-5 font-display text-3xl leading-tight tracking-tight sm:text-4xl lg:text-[2.9rem]"
        >
          Decisiones claras,<br />
          <span class="text-teal-300 italic">clínica ordenada.</span>
        </h2>
        <p class="mt-5 text-sm leading-relaxed text-white/65 sm:text-base">
          Un panel pensado para el día a día y también para la dirección: menos
          planillas, más tiempo para lo importante.
        </p>

        <ul class="mt-7 space-y-3">
          {
            highlights.map((item) => (
              <li class="flex items-start gap-3 text-sm">
                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-teal-400/20 text-teal-300">
                  <Icon name="check" class="h-3 w-3" />
                </span>
                <span class="text-white/80">{item}</span>
              </li>
            ))
          }
        </ul>

        <a
          href="/about/"
          class="group mt-8 inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-bold text-ink-900 transition-colors hover:bg-teal-50"
        >
          Conocer nuestro enfoque
          <Icon
            name="arrow-right"
            class="h-4 w-4 transition-transform group-hover:translate-x-1"
          />
        </a>
      </div>

      <!-- Mock del panel -->
      <div class="relative">
        <div
          aria-hidden="true"
          class="absolute -inset-3 rounded-[2rem] bg-gradient-to-tr from-teal-400/20 to-brand-400/10 blur-2xl"
        >
        </div>
        <div
          class="relative rounded-3xl border border-white/10 bg-white/[0.06] p-3 shadow-2xl backdrop-blur-sm sm:p-4"
        >
          <!-- Barra superior -->
          <div
            class="flex items-center justify-between border-b border-white/10 px-1 pb-3"
          >
            <div class="flex gap-1.5" aria-hidden="true">
              <span class="h-2 w-2 rounded-full bg-white/25"></span>
              <span class="h-2 w-2 rounded-full bg-white/25"></span>
              <span class="h-2 w-2 rounded-full bg-white/25"></span>
            </div>
            <span
              class="rounded-md bg-white/8 px-2 py-0.5 text-[9px] font-medium tracking-wide text-white/45"
            >
              panel.lumen.app
            </span>
          </div>

          <div class="mt-4 flex items-start justify-between gap-4 px-1">
            <div>
              <p
                class="text-[9px] font-bold tracking-[0.18em] text-white/35 uppercase"
              >
                Resumen de hoy
              </p>
              <p class="mt-1 font-display text-xl text-white sm:text-2xl">
                Buenos días, Dra. Paz
              </p>
            </div>
            <span
              class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-teal-400/15 px-2.5 py-1 text-[9px] font-semibold text-teal-200"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-teal-300"></span>
              En línea
            </span>
          </div>

          <!-- Mini métricas -->
          <div class="mt-4 grid grid-cols-3 gap-2">
            {
              [
                { label: "Turnos", value: "12" },
                { label: "Pacientes", value: "248" },
                { label: "Ingresos", value: "$184k" },
              ].map((item) => (
                <div class="rounded-xl bg-white/5 px-2.5 py-2 ring-1 ring-white/5">
                  <p class="text-[8px] font-semibold tracking-wider text-white/35 uppercase">
                    {item.label}
                  </p>
                  <p class="mt-0.5 font-display text-base text-white">
                    {item.value}
                  </p>
                </div>
              ))
            }
          </div>

          <!-- Gráfico -->
          <div class="mt-3 rounded-2xl bg-white/5 p-3 ring-1 ring-white/5">
            <div class="flex items-center justify-between">
              <p
                class="text-[8px] font-semibold tracking-wider text-white/35 uppercase"
              >
                Ingresos · últimos 7 días
              </p>
              <span class="text-[9px] font-bold text-teal-300">+18%</span>
            </div>
            <div
              class="mt-3 flex h-20 items-end gap-1.5"
              role="img"
              aria-label="Gráfico de ingresos en crecimiento durante los últimos siete días"
            >
              {
                weeklyRevenue.map((height, index) => (
                  <div
                    class:list={[
                      "flex-1 rounded-t-md",
                      index === weeklyRevenue.length - 1
                        ? "bg-brand-400"
                        : "bg-teal-400/45",
                    ]}
                    style={`height:${height}%`}
                  />
                ))
              }
            </div>
          </div>

          <!-- Turnos -->
          <div class="mt-3 space-y-1.5">
            {
              appointments.map((appointment) => (
                <div class="flex items-center gap-2.5 rounded-xl bg-white/5 px-2.5 py-2 ring-1 ring-white/5">
                  <span
                    class:list={[
                      "h-1.5 w-1.5 shrink-0 rounded-full",
                      appointment.tone,
                    ]}
                  />
                  <span class="w-9 shrink-0 text-[9px] font-semibold text-white/45">
                    {appointment.time}
                  </span>
                  <span class="flex-1 truncate text-[10px] font-semibold text-white/85">
                    {appointment.pet}
                  </span>
                  <span class="rounded-md bg-white/8 px-1.5 py-0.5 text-[8px] text-white/50">
                    {appointment.service}
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Notificación flotante -->
        <div
          class="absolute -bottom-4 -left-2 hidden items-center gap-2.5 rounded-2xl border border-white/10 bg-white p-3 shadow-xl sm:flex"
        >
          <span
            class="grid h-8 w-8 place-items-center rounded-full bg-teal-50 text-teal-600"
          >
            <Icon name="heart-pulse" class="h-4 w-4" />
          </span>
          <div>
            <p class="text-[11px] font-bold text-ink-900">
              Nuevo turno confirmado
            </p>
            <p class="text-[9px] text-ink-400">Luna · Hoy 16:30</p>
          </div>
          <Icon name="arrow-up-right" class="ml-1 h-3.5 w-3.5 text-ink-300" />
        </div>
      </div>
    </div>
  </div>
</section>
