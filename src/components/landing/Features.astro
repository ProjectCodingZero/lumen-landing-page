---
import Icon from "../ui/Icon.astro";

const features = [
  {
    icon: "clipboard",
    title: "Historia clínica compartida",
    description:
      "Cada consulta, vacuna y estudio queda disponible para la clínica y para el tutor al instante.",
  },
  {
    icon: "calendar",
    title: "Turnos sincronizados",
    description:
      "La agenda de la clínica y la app del tutor trabajan con la misma disponibilidad, sin dobles reservas.",
  },
  {
    icon: "bell",
    title: "Recordatorios que llegan",
    description:
      "Vacunas, controles y seguimientos automáticos para que ningún cuidado quede pendiente.",
  },
  {
    icon: "users",
    title: "Tutores conectados",
    description:
      "Un canal directo para compartir indicaciones, resultados y novedades sin perder el trato humano.",
  },
  {
    icon: "card",
    title: "Gestión sin fricción",
    description:
      "Cobros, inventario, especialistas y agenda en el mismo panel para todo el equipo de la clínica.",
  },
  {
    icon: "chart",
    title: "Datos para decidir",
    description:
      "Reportes claros de actividad, ocupación e ingresos para hacer crecer la clínica con foco.",
  },
] as const;
---

<section
  id="funciones"
  aria-labelledby="features-title"
  class="mx-auto max-w-7xl px-6 py-16 md:py-24"
>
  <div class="mx-auto max-w-2xl text-center">
    <span class="text-[11px] font-bold tracking-[0.22em] text-teal-600 uppercase">
      Un solo ecosistema
    </span>
    <h2
      id="features-title"
      class="mt-3 font-display text-3xl leading-tight tracking-tight text-ink-900 sm:text-4xl md:text-5xl"
    >
      Todo lo que comparten la app y el CRM
    </h2>
    <p class="mt-4 text-base leading-relaxed text-ink-500">
      Cuando la clínica y la familia trabajan sobre la misma información, cuidar
      se vuelve más simple para ambos lados.
    </p>
  </div>

  <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature) => (
        <article class="group relative rounded-3xl border border-ink-900/6 bg-white p-6 shadow-[0_1px_0_rgba(11,43,46,0.03)] transition-all duration-300 hover:-translate-y-1 hover:border-teal-200 hover:shadow-[0_28px_60px_-32px_rgba(11,43,46,0.35)]">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-teal-50 to-teal-100 text-teal-700 shadow-inner transition-colors group-hover:from-teal-500 group-hover:to-teal-600 group-hover:text-white">
            <Icon name={feature.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-5 text-lg font-bold tracking-tight text-ink-900">
            {feature.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-500">
            {feature.description}
          </p>
        </article>
      ))
    }
  </div>
</section>
