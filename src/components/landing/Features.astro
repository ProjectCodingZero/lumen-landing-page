---
import Icon from "../ui/Icon.astro";

const features = [
  {
    icon: "clipboard",
    title: "Historia clínica digital",
    description:
      "Toda la información de cada paciente —consultas, vacunas y estudios— disponible en segundos y desde cualquier dispositivo.",
  },
  {
    icon: "calendar",
    title: "Turnos inteligentes",
    description:
      "Agenda online 24/7 que se adapta a la disponibilidad real del equipo y reduce ausencias y llamados.",
  },
  {
    icon: "bell",
    title: "Recordatorios automáticos",
    description:
      "Vacunas, controles y seguimientos enviados en el momento justo para que ningún cuidado quede pendiente.",
  },
  {
    icon: "chart",
    title: "Métricas para decidir",
    description:
      "Ingresos, ocupación y evolución de pacientes en reportes claros que ayudan a tomar mejores decisiones.",
  },
  {
    icon: "users",
    title: "Cercanía con tutores",
    description:
      "Un canal directo para compartir novedades, indicaciones y resultados sin perder el trato humano.",
  },
  {
    icon: "card",
    title: "Pagos y facturación",
    description:
      "Cobros integrados, comprobantes automáticos y una experiencia simple también en la administración.",
  },
] as const;
---

<section
  id="soluciones"
  aria-labelledby="features-title"
  class="mx-auto max-w-7xl px-6 py-16 md:py-24"
>
  <div class="mx-auto max-w-2xl text-center">
    <span class="text-[11px] font-bold tracking-[0.22em] text-teal-600 uppercase">
      Todo en un solo lugar
    </span>
    <h2
      id="features-title"
      class="mt-3 font-display text-3xl leading-tight tracking-tight text-ink-900 sm:text-4xl md:text-5xl"
    >
      Una plataforma, toda tu clínica conectada
    </h2>
    <p class="mt-4 text-base leading-relaxed text-ink-500">
      Lumen reúne la operación diaria y el vínculo con cada familia en una
      experiencia simple, ordenada y pensada para crecer.
    </p>
  </div>

  <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature) => (
        <article class="group relative rounded-3xl border border-ink-900/6 bg-white p-6 shadow-[0_1px_0_rgba(11,43,46,0.03)] transition-all duration-300 hover:-translate-y-1 hover:border-teal-200 hover:shadow-[0_28px_60px_-32px_rgba(11,43,46,0.35)]">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-teal-50 to-teal-100 text-teal-700 shadow-inner transition-colors group-hover:from-teal-500 group-hover:to-teal-600 group-hover:text-white">
            <Icon name={feature.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-5 text-lg font-bold tracking-tight text-ink-900">
            {feature.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-500">
            {feature.description}
          </p>
        </article>
      ))
    }
  </div>
</section>
