---
import Icon from "../ui/Icon.astro";
import { productUrls } from "../../data/products.ts";

const trustedPets = [
  { src: "/images/pet-dog.jpg", alt: "Perro paciente de Lumen" },
  { src: "/images/pet-cat.jpg", alt: "Gato paciente de Lumen" },
  { src: "/images/pet-puppy.jpg", alt: "Cachorro paciente de Lumen" },
];
---

<section
  aria-labelledby="hero-title"
  class="relative isolate overflow-hidden"
>
  <!-- Fondos decorativos -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(70%_60%_at_85%_-5%,#d9eff0_0%,transparent_65%)]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-40 -left-32 -z-10 h-80 w-80 rounded-full bg-brand-100/60 blur-3xl"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-full bg-[radial-gradient(#c5d9d5_1px,transparent_1px)] opacity-30 [background-size:26px_26px] [mask-image:linear-gradient(to_bottom,black,transparent_55%)]"
  >
  </div>

  <div
    class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-6 pt-14 pb-16 lg:grid-cols-[1.02fr_0.98fr] lg:gap-12 lg:pt-20 lg:pb-24"
  >
    <!-- Copy -->
    <div class="max-w-xl">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-ink-900/10 bg-white/80 px-3.5 py-1.5 text-[11px] font-bold tracking-[0.16em] text-ink-700 uppercase shadow-sm backdrop-blur"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-70"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-teal-500"></span>
        </span>
        Lumen App + Lumen Web · Ecosistema veterinario
      </span>

      <h1
        id="hero-title"
        class="mt-6 font-display text-[2.75rem] leading-[0.98] tracking-tight text-ink-900 sm:text-6xl lg:text-[4.4rem]"
      >
        Veterinarias y familias,<br />
        <span class="text-teal-600 italic">por fin conectadas.</span>
      </h1>

      <p class="mt-6 max-w-lg text-base leading-relaxed text-ink-500 sm:text-lg">
        Lumen une a tu clínica con cada familia: una app para que los tutores
        cuiden a su mascota y un CRM para que el equipo veterinario gestione
        todo desde un solo lugar.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={productUrls.app}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-2 rounded-full bg-ink-900 px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-ink-900/20 transition-all hover:-translate-y-0.5 hover:bg-teal-700 hover:shadow-xl active:translate-y-0"
        >
          Abrir Lumen App
          <Icon
            name="arrow-up-right"
            class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
        <a
          href={productUrls.web}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-2 rounded-full border border-ink-900/15 bg-white/70 px-6 py-3.5 text-sm font-bold text-ink-800 backdrop-blur transition-colors hover:border-ink-900/30 hover:bg-white"
        >
          Ingresar a Lumen Web
          <Icon
            name="arrow-up-right"
            class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
      </div>

      <!-- Prueba social -->
      <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3">
        <div class="flex -space-x-2.5">
          {
            trustedPets.map((pet) => (
              <img
                src={pet.src}
                alt={pet.alt}
                width="40"
                height="40"
                loading="lazy"
                decoding="async"
                class="h-10 w-10 rounded-full border-2 border-cream object-cover"
              />
            ))
          }
        </div>
        <div>
          <div class="flex items-center gap-1.5 text-teal-600">
            <Icon name="check" class="h-3.5 w-3.5" />
            <span class="text-xs font-bold text-ink-800">
              Una sola historia clínica
            </span>
          </div>
          <p class="mt-0.5 text-xs font-medium text-ink-500">
            Tutores y clínicas viendo la misma información, en tiempo real.
          </p>
        </div>
      </div>
    </div>

    <!-- Visual -->
    <div class="relative mx-auto w-full max-w-lg lg:max-w-none">
      <div
        aria-hidden="true"
        class="absolute -inset-4 -z-10 rounded-[3rem] bg-gradient-to-tr from-teal-200/80 via-brand-100/70 to-white blur-2xl"
      >
      </div>
      <div
        class="relative overflow-hidden rounded-[2.5rem] border border-white bg-white p-2.5 shadow-[0_35px_90px_-35px_rgba(11,43,46,0.55)]"
      >
        <div class="relative overflow-hidden rounded-[2rem]">
          <img
            src="/images/hero-dog.jpg"
            alt="Perro sonriente junto a su tutora, conectados a través de Lumen"
            width="1200"
            height="1200"
            fetchpriority="high"
            decoding="async"
            class="h-[350px] w-full object-cover sm:h-[430px] lg:h-[500px]"
          />
          <div
            aria-hidden="true"
            class="absolute inset-0 bg-gradient-to-t from-ink-950/55 via-transparent to-transparent"
          >
          </div>

          <div class="absolute inset-x-5 bottom-5 text-white">
            <p
              class="text-[10px] font-bold tracking-[0.22em] text-white/70 uppercase"
            >
              Ficha digital compartida
            </p>
            <div class="mt-1 flex items-end justify-between gap-4">
              <div>
                <p class="font-display text-2xl leading-none">Luna</p>
                <p class="mt-1 text-xs text-white/75">
                  Golden Retriever · 3 años
                </p>
              </div>
              <span
                class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 text-[11px] font-semibold backdrop-blur-md"
              >
                <Icon name="heart-pulse" class="h-3.5 w-3.5" />
                Salud al día
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tarjeta flotante: próximo turno -->
      <div
        class="absolute top-7 -left-2 animate-float rounded-2xl border border-ink-900/5 bg-white/95 p-3.5 shadow-xl shadow-ink-900/10 backdrop-blur sm:-left-7"
      >
        <div class="flex items-center gap-3">
          <span
            class="grid h-10 w-10 place-items-center rounded-xl bg-brand-100 text-brand-600"
          >
            <Icon name="calendar" class="h-5 w-5" />
          </span>
          <div>
            <p
              class="text-[10px] font-bold tracking-wider text-ink-400 uppercase"
            >
              Próximo turno
            </p>
            <p class="text-sm font-bold text-ink-900">Hoy · 16:30</p>
            <p class="text-[11px] font-medium text-teal-600">
              Vacunación anual
            </p>
          </div>
        </div>
      </div>

      <!-- Tarjeta flotante: recordatorio -->
      <div
        class="absolute -right-2 bottom-9 animate-float-slow rounded-2xl border border-ink-900/5 bg-white/95 p-3.5 shadow-xl shadow-ink-900/10 backdrop-blur sm:-right-7"
      >
        <div class="flex items-center gap-2.5">
          <span
            class="grid h-8 w-8 place-items-center rounded-full bg-teal-50 text-teal-600"
          >
            <Icon name="check" class="h-4 w-4" />
          </span>
          <div>
            <p class="text-xs font-bold text-ink-900">Recordatorio enviado</p>
            <p class="text-[10px] text-ink-400">Control en 7 días</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
