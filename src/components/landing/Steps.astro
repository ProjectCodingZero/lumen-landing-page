---
import Icon from "../ui/Icon.astro";

const steps = [
  {
    icon: "stethoscope",
    title: "Elegí el servicio",
    description:
      "Consultas, cirugías, vacunación o estética. Encontrá la especialidad que tu mascota necesita.",
  },
  {
    icon: "calendar",
    title: "Reservá en segundos",
    description:
      "Seleccioná día y horario según la disponibilidad real del equipo, sin llamados ni esperas.",
  },
  {
    icon: "check",
    title: "Llegá y listo",
    description:
      "Recibí la confirmación y los recordatorios automáticos. Nosotros nos ocupamos del resto.",
  },
] as const;
---

<section
  aria-labelledby="steps-title"
  class="mx-auto max-w-7xl px-6 pb-16 md:pb-24"
>
  <div class="mx-auto max-w-2xl text-center">
    <span class="text-[11px] font-bold tracking-[0.22em] text-teal-600 uppercase">
      Simple desde el primer clic
    </span>
    <h2
      id="steps-title"
      class="mt-3 font-display text-3xl leading-tight tracking-tight text-ink-900 sm:text-4xl md:text-5xl"
    >
      Reservar tu turno en 3 pasos
    </h2>
    <p class="mt-4 text-base leading-relaxed text-ink-500">
      Pensamos cada detalle para que cuidar de tu mascota sea tan simple como
      debería ser.
    </p>
  </div>

  <div class="relative mt-12">
    <div
      aria-hidden="true"
      class="absolute top-[4.5rem] right-[16%] left-[16%] hidden border-t border-dashed border-ink-900/15 md:block"
    >
    </div>
    <ol class="relative grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="flex flex-col items-center rounded-3xl border border-ink-900/6 bg-white px-6 pt-8 pb-7 text-center shadow-[0_1px_0_rgba(11,43,46,0.03)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_28px_60px_-32px_rgba(11,43,46,0.3)]">
            <div class="relative">
              <span class="grid h-16 w-16 place-items-center rounded-2xl bg-ink-900 text-white shadow-lg shadow-ink-900/15">
                <Icon name={step.icon} class="h-7 w-7" />
              </span>
              <span class="absolute -top-2 -right-2 grid h-7 w-7 place-items-center rounded-full border-2 border-white bg-brand-500 text-[11px] font-extrabold text-white">
                {index + 1}
              </span>
            </div>
            <h3 class="mt-5 text-lg font-bold tracking-tight text-ink-900">
              {step.title}
            </h3>
            <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-500">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
