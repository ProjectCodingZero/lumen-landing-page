---
const stats = [
  { value: "2", label: "apps, un mismo ecosistema" },
  { value: "1", label: "historia clínica compartida" },
  { value: "24/7", label: "acceso desde cualquier dispositivo" },
  { value: "100%", label: "en la nube, siempre sincronizado" },
];
---

<section aria-label="Lumen en números" class="border-y border-ink-900/6 bg-white">
  <dl
    class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-8 px-6 py-10 sm:grid-cols-4 sm:py-12"
  >
    {
      stats.map((stat) => (
        <div class="flex flex-col-reverse items-center border-ink-900/8 text-center sm:border-l sm:first:border-l-0">
          <dt class="mt-2 max-w-[11rem] text-xs leading-snug font-medium text-ink-500">
            {stat.label}
          </dt>
          <dd class="font-display text-4xl leading-none text-ink-900 sm:text-5xl">
            {stat.value}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
