---
type LinkVariant = "default" | "button" | "muted" | "none";


interface Props {
	variant?: LinkVariant;
  isExternal?: boolean;
  href: string;
  class?: string;
}
const { 
  href, 
  variant = "default", 
  isExternal = false, 
  class : className = ""
}: Props = Astro.props;
const STYLES: Record<LinkVariant, string> = {
  none: "",
  default: "text-teal-500 font-medium hover:underline transition-colors",
  button:
    "inline-flex items-center justify-center font-bold rounded transition-colors",
  muted: "text-gray-500 hover:text-gray-900 transition-colors",
};
const activeStyle = STYLES[variant] ?? STYLES["default"];
---
<a 
href={href} 
class:list={[activeStyle, className ?? ""]} 
target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined}>
  <slot />
</a>
