---
import Icon from "../../components/ui/Icon.astro";
import { productUrls } from "../../data/products.ts";

const currentPath = Astro.url.pathname;
const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/productos/", label: "Productos" },
  { href: "/about/", label: "Nosotros" },
];

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const linkBase =
  "rounded-full px-4 py-2 text-sm font-semibold transition-colors";
---

<header
  class="sticky top-0 z-50 border-b border-ink-900/6 bg-cream/85 backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-4 px-5 sm:px-6"
  >
    <a
      href="/"
      aria-label="Lumen, ecosistema veterinario, ir al inicio"
      class="group flex items-center gap-3"
    >
      <span
        class="grid h-11 w-11 place-items-center rounded-2xl bg-ink-900 text-white shadow-lg shadow-ink-900/15 transition-colors duration-300 group-hover:bg-teal-600"
      >
        <Icon name="paw" class="h-6 w-6" />
      </span>
      <span class="leading-none">
        <span
          class="block font-display text-xl font-semibold tracking-tight text-ink-900"
        >
          Lumen
        </span>
        <span
          class="mt-1 block text-[9px] font-bold tracking-[0.26em] text-ink-400 uppercase"
        >
          Ecosistema veterinario
        </span>
      </span>
    </a>

    <nav
      aria-label="Navegación principal"
      class="hidden items-center gap-1 rounded-full border border-ink-900/6 bg-white/70 p-1.5 shadow-sm md:flex"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              linkBase,
              isActive(item.href)
                ? "bg-ink-900 text-white shadow-sm"
                : "text-ink-600 hover:bg-white hover:text-ink-900",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={productUrls.app}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 rounded-full px-3 py-2 text-xs font-semibold text-ink-500 transition-colors hover:text-ink-900 lg:inline-flex"
      >
        <Icon name="paw" class="h-4 w-4 text-teal-600" />
        Lumen App
      </a>

      <details class="group relative hidden sm:block">
        <summary
          class="flex cursor-pointer list-none items-center gap-2 rounded-full bg-ink-900 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-ink-900/15 transition-all hover:-translate-y-0.5 hover:bg-teal-700 [&::-webkit-details-marker]:hidden"
        >
          Probar Lumen
          <Icon
            name="chevron-down"
            class="h-4 w-4 transition-transform group-open:rotate-180"
          />
        </summary>

        <div
          class="absolute top-full right-0 mt-3 w-72 overflow-hidden rounded-3xl border border-ink-900/8 bg-white p-2 shadow-2xl shadow-ink-900/15"
        >
          <a
            href={productUrls.app}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start gap-3 rounded-2xl px-3 py-3 transition-colors hover:bg-cream"
          >
            <span
              class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-teal-50 text-teal-600"
            >
              <Icon name="paw" class="h-4 w-4" />
            </span>
            <span>
              <span class="block text-sm font-bold text-ink-900">
                Lumen App
              </span>
              <span class="block text-xs font-medium text-ink-500">
                Para tutores
              </span>
            </span>
            <Icon
              name="arrow-up-right"
              class="mt-1 ml-auto h-4 w-4 text-ink-400"
            />
          </a>

          <a
            href={productUrls.web}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start gap-3 rounded-2xl px-3 py-3 transition-colors hover:bg-cream"
          >
            <span
              class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-brand-100 text-brand-600"
            >
              <Icon name="stethoscope" class="h-4 w-4" />
            </span>
            <span>
              <span class="block text-sm font-bold text-ink-900">
                Lumen Web
              </span>
              <span class="block text-xs font-medium text-ink-500">
                Para clínicas
              </span>
            </span>
            <Icon
              name="arrow-up-right"
              class="mt-1 ml-auto h-4 w-4 text-ink-400"
            />
          </a>
        </div>
      </details>

      <details class="group relative md:hidden">
        <summary
          class="grid h-11 w-11 cursor-pointer list-none place-items-center rounded-full border border-ink-900/10 bg-white text-ink-800 shadow-sm transition-colors hover:bg-ink-50 [&::-webkit-details-marker]:hidden"
        >
          <Icon name="menu" class="h-5 w-5 group-open:hidden" />
          <Icon name="close" class="hidden h-5 w-5 group-open:block" />
          <span class="sr-only">Abrir menú de navegación</span>
        </summary>

        <div
          class="absolute top-full right-0 mt-3 w-64 overflow-hidden rounded-3xl border border-ink-900/8 bg-white p-2 shadow-2xl shadow-ink-900/15"
        >
          <nav aria-label="Navegación móvil" class="flex flex-col">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "rounded-2xl px-4 py-3 text-sm font-semibold transition-colors",
                    isActive(item.href)
                      ? "bg-ink-900 text-white"
                      : "text-ink-700 hover:bg-cream",
                  ]}
                >
                  {item.label}
                </a>
              ))
            }

            <div class="mt-2 grid gap-1.5 border-t border-ink-900/6 pt-2">
              <a
                href={productUrls.app}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-2xl px-4 py-3 text-sm font-semibold text-ink-700 transition-colors hover:bg-cream"
              >
                <Icon name="paw" class="h-4 w-4 text-teal-600" />
                Abrir Lumen App
                <Icon name="arrow-up-right" class="ml-auto h-4 w-4 text-ink-400" />
              </a>
              <a
                href={productUrls.web}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-2xl bg-teal-600 px-4 py-3 text-sm font-bold text-white"
              >
                <Icon name="stethoscope" class="h-4 w-4" />
                Ingresar a Lumen Web
                <Icon name="arrow-up-right" class="ml-auto h-4 w-4" />
              </a>
            </div>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
