---
import Link from "./Link.astro";

import { isActive } from "../utils/navigation";


const linkStyle = (isActive: boolean) =>
  `rounded-lg px-4 py-2 border-2 border-transparent transition-colors hover:border-current ${
    isActive
      ? "text-brand-600 hover:text-brand-700 bg-brand-200/60 hover:bg-brand-200/80"
      : "text-teal-500 hover:text-teal-700 bg-teal-200/60 hover:bg-teal-200/80"
  }`;
const currentPath = Astro.url.pathname;
---

<header class="bg-teal-200 shadow-sm sticky top-0 z-50"></header>
    <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
        {/* Logo y Nombre */}
        <Link
          href="/"
          class="flex items-center space-x-3 group"
        >
          <div class="text-3xl text-brand-500 transition-transform hover:scale-105 ease-out duration-300">
            L
          </div>
          <div>
            <h1 class="group-hover:text-teal-700 ease-in-out duration-300 text-teal-400 font-extrabold text-lg text-brand-500 leading-tight tracking-tight">
              LUMEN
            </h1>
            <p class="text-[10px] group-hover:text-gray-800 ease-in-out duration-300 font-bold text-gray-500 uppercase tracking-widest">
              TUCUMÁN
            </p>
          </div>
        </Link>

        {/* Navegación Desktop */}
        <nav class="ease-out duration-300 hidden md:flex items-center space-x-8 font-semibold text-sm bg-teal-100 rounded-lg px-4 py-2 shadow-sm border-2 border-teal-100/80">
          <Link
            variant="button"
            href="/"
            class={linkStyle(isActive(currentPath, "/home"))}
          >
            Inicio
          </Link>
          <Link
            variant="button"
            href="/services"
            class={linkStyle(isActive(currentPath,"/services"))}
          >
            Servicios
          </Link>
          <Link
            variant="button"
            href="/appointments"
            class={linkStyle(isActive(currentPath, "/appointments"))}
          >
            Turnos
          </Link>
          <Link
            variant="button"
            href="/about"
            class={linkStyle(isActive(currentPath, "/about"))}
          >
            Nosotros
          </Link>
          <Link
            variant="button"
            href="/contact"
            class={linkStyle(isActive(currentPath, "/contact"))}
          >
            Contacto
          </Link>
        </nav>

        {/* Botón Mi Mascota */}
        <div>
          <Link
            href="/my-pet"
            class="bg-[#009ba4] hover:bg-[#00838b] text-white font-bold text-sm px-5 py-2.5 rounded-full flex items-center space-x-2 shadow-sm transition-all active:scale-95"
          >
            <span>Mi Mascota</span>
            <span>🐾</span>
          </Link>
        </div>
      </div>
</header>
