---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import { productUrls } from "../data/products.ts";
---

<BaseLayout
  title="Página no encontrada | Lumen"
  description="La página que buscás no existe o cambió de lugar. Volvé al inicio o conocé Lumen App y Lumen Web."
  noindex={true}
>
  <section
    aria-labelledby="not-found-title"
    class="mx-auto flex max-w-3xl flex-col items-center px-6 py-24 text-center md:py-32"
  >
    <span
      class="grid h-16 w-16 place-items-center rounded-3xl bg-ink-900 text-teal-300 shadow-xl shadow-ink-900/15"
    >
      <Icon name="paw" class="h-8 w-8" />
    </span>
    <p class="mt-8 font-display text-6xl text-teal-600 italic">404</p>
    <h1
      id="not-found-title"
      class="mt-2 font-display text-3xl leading-tight tracking-tight text-ink-900 sm:text-5xl"
    >
      Esta página se fue a pasear.
    </h1>
    <p class="mt-4 max-w-md text-base leading-relaxed text-ink-500">
      No encontramos lo que buscabas. Volvé al inicio o entrá directo a Lumen
      App si sos tutor, o a Lumen Web si gestionás una clínica.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="/"
        class="group inline-flex items-center justify-center gap-2 rounded-full bg-ink-900 px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-ink-900/20 transition-all hover:-translate-y-0.5 hover:bg-teal-700"
      >
        Volver al inicio
        <Icon
          name="arrow-right"
          class="h-4 w-4 transition-transform group-hover:translate-x-1"
        />
      </a>
      <a
        href={productUrls.web}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-full border border-ink-900/15 bg-white px-6 py-3.5 text-sm font-bold text-ink-800 transition-colors hover:border-ink-900/30"
      >
        <Icon name="stethoscope" class="h-4 w-4 text-teal-600" />
        Ir a Lumen Web
      </a>
    </div>

    <a
      href="/productos/"
      class="mt-6 text-xs font-semibold text-ink-400 transition-colors hover:text-ink-700"
    >
      Ver todos los productos
    </a>
  </section>
</BaseLayout>
