---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import { services } from "../data/services.ts";

const title = "Servicios veterinarios en Tucumán | Lumen";
const description =
  "Consultas médicas, cirugía y laboratorio, vacunación y estética especializada. Conocé los servicios veterinarios de Lumen en San Miguel de Tucumán y reservá tu turno online.";

const offerCatalogSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "Servicios veterinarios Lumen",
  itemListElement: services.map((service, index) => ({
    "@type": "Offer",
    position: index + 1,
    itemOffered: {
      "@type": "Service",
      name: service.title,
      description: service.description,
      provider: { "@id": "https://lumen-soft.app/#organizacion" },
      areaServed: "San Miguel de Tucumán",
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: "https://lumen-soft.app/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Servicios",
      item: "https://lumen-soft.app/services/",
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[offerCatalogSchema, breadcrumbSchema]}
>
  <section class="relative isolate overflow-hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_50%_-10%,#d9eff0_0%,transparent_70%)]"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-64 bg-[radial-gradient(#c5d9d5_1px,transparent_1px)] opacity-30 [background-size:26px_26px] [mask-image:linear-gradient(to_bottom,black,transparent)]"
    >
    </div>

    <div class="mx-auto max-w-3xl px-6 pt-14 pb-12 text-center md:pt-20">
      <nav aria-label="Miga de pan" class="mb-6">
        <ol class="flex items-center justify-center gap-2 text-xs font-semibold text-ink-400">
          <li><a href="/" class="transition-colors hover:text-ink-900">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink-700">Servicios</li>
        </ol>
      </nav>

      <span
        class="inline-flex items-center gap-2 rounded-full border border-ink-900/10 bg-white/80 px-3.5 py-1.5 text-[11px] font-bold tracking-[0.16em] text-ink-700 uppercase shadow-sm backdrop-blur"
      >
        <Icon name="sparkles" class="h-3.5 w-3.5 text-teal-600" />
        Excelencia profesional
      </span>

      <h1
        class="mt-6 font-display text-4xl leading-[1.02] tracking-tight text-ink-900 sm:text-5xl md:text-6xl"
      >
        Cuidado especializado para
        <span class="text-teal-600 italic"> cada etapa</span> de su vida.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-ink-500">
        Una gama completa de prestaciones médicas, quirúrgicas y de estética
        diseñadas para el bienestar integral de tu mascota.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="#turnos"
          class="group inline-flex items-center gap-2 rounded-full bg-ink-900 px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-ink-900/20 transition-all hover:-translate-y-0.5 hover:bg-teal-700"
        >
          Reservar un turno
          <Icon
            name="arrow-right"
            class="h-4 w-4 transition-transform group-hover:translate-x-1"
          />
        </a>
        <a
          href="https://wa.me/5493812335259?text=Hola%20Lumen%2C%20quiero%20hacer%20una%20consulta"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-ink-900/15 bg-white/70 px-6 py-3.5 text-sm font-bold text-ink-800 backdrop-blur transition-colors hover:border-ink-900/30 hover:bg-white"
        >
          <Icon name="whatsapp" class="h-4 w-4 text-teal-600" />
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section aria-label="Servicios" class="mx-auto max-w-7xl px-6 pb-16 md:pb-24">
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {
        services.map((service) => (
          <article
            id={service.id}
            class="group flex h-full flex-col rounded-3xl border border-ink-900/6 bg-white p-7 shadow-[0_1px_0_rgba(11,43,46,0.03)] transition-all duration-300 hover:-translate-y-1 hover:border-teal-200 hover:shadow-[0_28px_60px_-32px_rgba(11,43,46,0.35)]"
          >
            <div class="flex items-start justify-between gap-4">
              <span
                class:list={[
                  "grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br",
                  service.accent,
                ]}
              >
                <Icon name={service.icon} class="h-7 w-7" />
              </span>
              <span
                class:list={[
                  "rounded-full px-2.5 py-1 text-[10px] font-bold tracking-wide uppercase",
                  service.badgeTone,
                ]}
              >
                {service.badge}
              </span>
            </div>

            <h2 class="mt-5 text-xl font-bold tracking-tight text-ink-900">
              {service.title}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">
              {service.description}
            </p>

            <ul class="mt-5 space-y-2">
              {service.features.map((feature) => (
                <li class="flex items-center gap-2 text-xs font-medium text-ink-600">
                  <Icon name="check" class="h-3.5 w-3.5 text-teal-600" />
                  {feature}
                </li>
              ))}
            </ul>

            <a
              href="#turnos"
              class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-cream px-4 py-2 text-xs font-bold text-ink-800 transition-colors group-hover:bg-teal-600 group-hover:text-white"
            >
              Reservar este servicio
              <Icon name="arrow-right" class="h-3.5 w-3.5" />
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section
    id="turnos"
    aria-labelledby="turnos-title"
    class="px-4 pb-20 sm:px-6 md:pb-28"
  >
    <div
      class="relative mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-ink-900 px-6 py-12 text-white shadow-[0_40px_100px_-45px_rgba(6,27,29,0.9)] sm:rounded-[2.5rem] sm:px-10 lg:px-14 lg:py-16"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(#ffffff_1px,transparent_1px)] opacity-[0.06] [background-size:22px_22px]"
      >
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-24 -right-20 h-80 w-80 rounded-full bg-teal-500/20 blur-3xl"
      >
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-24 -left-16 h-72 w-72 rounded-full bg-brand-500/15 blur-3xl"
      >
      </div>

      <div class="relative grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="max-w-lg">
          <span
            class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-[10px] font-bold tracking-[0.2em] text-teal-200 uppercase"
          >
            <Icon name="calendar" class="h-3.5 w-3.5" />
            Turnos
          </span>
          <h2
            id="turnos-title"
            class="mt-5 font-display text-3xl leading-tight tracking-tight sm:text-4xl"
          >
            Reservá en segundos,
            <span class="text-teal-300 italic">sin esperas.</span>
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-white/65">
            Elegí el servicio, el día y el horario que mejor te queden. Te
            confirmamos el turno y te avisamos antes de la consulta.
          </p>

          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a
              href="https://wa.me/5493812335259?text=Hola%20Lumen%2C%20quiero%20reservar%20un%20turno"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center justify-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-bold text-ink-900 transition-all hover:-translate-y-0.5 hover:bg-teal-50"
            >
              <Icon name="whatsapp" class="h-4 w-4 text-teal-600" />
              Reservar por WhatsApp
            </a>
            <a
              href="tel:+5493812335259"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-white/10"
            >
              <Icon name="phone" class="h-4 w-4" />
              Llamar ahora
            </a>
          </div>
        </div>

        <ol class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
          {
            [
              {
                icon: "stethoscope",
                title: "Elegí el servicio",
                copy: "Consulta, cirugía, vacunación o estética.",
              },
              {
                icon: "calendar",
                title: "Seleccioná día y hora",
                copy: "Disponibilidad real del equipo, online.",
              },
              {
                icon: "check",
                title: "Confirmá y listo",
                copy: "Recordatorios automáticos antes del turno.",
              },
            ].map((step, index) => (
              <li class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/5 p-4">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-teal-400/20 text-teal-200">
                  <Icon name={step.icon} class="h-5 w-5" />
                </span>
                <div>
                  <p class="text-[10px] font-bold tracking-[0.18em] text-white/35 uppercase">
                    Paso {index + 1}
                  </p>
                  <p class="text-sm font-bold text-white">{step.title}</p>
                  <p class="text-xs text-white/50">{step.copy}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>
