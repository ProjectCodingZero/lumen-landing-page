---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/landing/Hero.astro";
import Ecosystem from "../components/landing/Ecosystem.astro";
import Metrics from "../components/landing/Metrics.astro";
import Features from "../components/landing/Features.astro";
import AppShowcase from "../components/landing/AppShowcase.astro";
import Platform from "../components/landing/Platform.astro";
import Steps from "../components/landing/Steps.astro";
import Testimonials from "../components/landing/Testimonials.astro";
import FAQ from "../components/landing/FAQ.astro";
import CTA from "../components/landing/CTA.astro";
import { faqs } from "../data/faqs.ts";
import { productUrls } from "../data/products.ts";

const title = "Lumen | La plataforma que conecta veterinarias y familias";
const description =
  "Lumen App para tutores y Lumen Web para clínicas: turnos, historia clínica compartida, recordatorios y gestión veterinaria en un solo ecosistema.";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Lumen",
  url: "https://lumen-soft.app/",
  inLanguage: "es-AR",
  publisher: {
    "@id": "https://lumen-soft.app/#organizacion",
  },
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Lumen App",
  applicationCategory: "HealthApplication",
  operatingSystem: "iOS, Android",
  description:
    "App para tutores: turnos, historia clínica compartida, vacunas y recordatorios de cada mascota.",
  url: productUrls.app,
  publisher: {
    "@id": "https://lumen-soft.app/#organizacion",
  },
};

const webSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Lumen Web",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "CRM veterinario para clínicas: agenda, pacientes, tutores, inventario, especialistas y reportes.",
  url: productUrls.web,
  publisher: {
    "@id": "https://lumen-soft.app/#organizacion",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[websiteSchema, appSchema, webSchema, faqSchema]}
>
  <Hero />
  <Metrics />
  <Ecosystem />
  <Features />
  <AppShowcase />
  <Platform />
  <Steps />
  <Testimonials />
  <FAQ />
  <CTA />
</BaseLayout>
